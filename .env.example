# Copy to .env (gitignored). Never paste these values into chat or commits.

# Meta Model API — https://dev.meta.ai (Billing: set a $150 spend-limit notification)
MODEL_API_KEY=

# LINE Messaging API — LINE Developers console > your channel
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Your own LINE userId (from the first webhook event); only this sender is accepted
LINE_OWNER_USER_ID=

# Runner
EYESONQA_PORT=8765
EYESONQA_TOTAL_CAP_USD=120
EYESONQA_GOAL_CAP_USD=3
